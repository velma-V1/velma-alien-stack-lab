def stable_hash(value: Any) -> str:
    data = json.dumps(value, sort_keys=True, separators=(",", ":"), default=str).encode()
    return hashlib.sha256(data).hexdigest()


def atomic_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


@dataclass(frozen=True)
class SurfaceAction:
    semantic_id: str
    locator: str
    label: str
    slot: int
    op: str
    target: int
    arg: int
    forbidden: bool = False


@dataclass(frozen=True)
class TaskSpec:
    task_id: str
    family: str
    difficulty: int
    stage: str
    lineage: str
    seed: int
    initial: tuple[int, ...]
    actions: tuple[SurfaceAction, ...]
    required_semantics: tuple[str, ...]
    public_flag: int
    silent_fault: bool
    drift_severity: int
    oracle_final: tuple[int, ...]
    oracle_hash: str

    def public_dict(self) -> dict[str, Any]:
        return {
            "task_id": self.task_id, "family": self.family, "difficulty": self.difficulty,
            "stage": self.stage, "lineage": self.lineage, "initial": list(self.initial),
            "public_flag": self.public_flag, "surface": [
                {"locator": a.locator, "label": a.label, "slot": a.slot, "forbidden": a.forbidden}
                for a in self.actions
            ],
        }


@dataclass
class MemoryRecord:
    record_id: str
    family: str
    semantics: tuple[str, ...]
    learned_stage: str
    evidence_id: str
    fingerprint: str


@dataclass
class AlienMemory:
    records: dict[str, MemoryRecord] = field(default_factory=dict)

    def retrieve(self, task: TaskSpec, limit: int = 4) -> list[MemoryRecord]:
        rows = [r for r in self.records.values() if r.family == task.family]
        rows.sort(key=lambda r: (r.learned_stage, r.record_id), reverse=True)
        return rows[:limit]

    def promote(self, task: TaskSpec, semantics: tuple[str, ...], evidence_id: str, verified: bool) -> MemoryRecord | None:
        if not verified or not semantics:
            return None
        rid = "M" + stable_hash([task.family, semantics, evidence_id])[:12]
        if rid in self.records:
            return self.records[rid]
        rec = MemoryRecord(rid, task.family, semantics, task.stage, evidence_id,
                           stable_hash([rid, task.family, semantics, task.stage, evidence_id]))
        self.records[rid] = rec
        return rec

    def to_dict(self) -> dict[str, Any]:
        return {k: asdict(v) for k, v in self.records.items()}

    @classmethod
    def from_dict(cls, doc: dict[str, Any]) -> "AlienMemory":
        return cls({k: MemoryRecord(**{**v, "semantics": tuple(v["semantics"])}) for k, v in doc.items()})


@dataclass
class CompiledSkill:
    skill_id: str
    family: str
    semantics: tuple[str, ...]
    learned_locators: tuple[str, ...]
    learned_labels: tuple[str, ...]
    learned_slots: tuple[int, ...]
    evidence_id: str


@dataclass
class SkillRegistry:
    skills: dict[str, CompiledSkill] = field(default_factory=dict)

    def compile_verified(self, task: TaskSpec, semantics: tuple[str, ...], locators: tuple[str, ...], evidence_id: str,
                         verified: bool) -> CompiledSkill | None:
        if not verified or not semantics:
            return None
        by_sem = {a.semantic_id: a for a in task.actions}
        labels = tuple(by_sem[s].label for s in semantics if s in by_sem)
        slots = tuple(by_sem[s].slot for s in semantics if s in by_sem)
        sid = "S" + stable_hash([task.family, semantics, evidence_id])[:12]
        skill = CompiledSkill(sid, task.family, semantics, locators, labels, slots, evidence_id)
        self.skills[sid] = skill
        return skill
