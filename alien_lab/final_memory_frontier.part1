    """Greedy exact contiguous cover. Returns operations and macro IDs used."""
    macros = sorted(store.learned_macros(), key=lambda m: (-len(m.rule_ids), m.macro_id))
    ops: list[tuple[str, str]] = []
    used: set[str] = set()
